# Copie este arquivo para .env e preencha as URLs dos serviços.
# cp .env.example .env

# Portas: interna do gateway e publicada pelo Docker Compose.
GATEWAY_PORT=2399
GATEWAY_HOST_PORT=2399

# Opções HTTP (os valores abaixo são os padrões).
CORS_ORIGINS=
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
PROXY_TIMEOUT_MS=30000
STANDARD_PROXY_ERRORS_ENABLED=true
STRICT_ROUTE_MODE=false

# MAIN_SERVICE é obrigatório; demais destinos podem ficar vazios. Em Docker, use DNS e porta interna do serviço.
# Exemplo: TELAS_SERVICE=http://telas-service:3000
MAIN_SERVICE=
ERP_MODELAGEM_SERVICE=http://host.docker.internal:3001
INDEX_INFORMATIVO_SERVICE=
TELAS_SERVICE=
SOBRACORTE_SERVICE=
UPLOAD_SERVICE=
DIESEL_SERVICE=
PORTA_EMERG_SERVICE=
PORTARIA_SERVICE=
PORTA_RFID_SERVICE=
AUTOMATION_SERVICE=
DP_SERVICE=
QUIMICO_SERVICE=
REFEITORIO_SERVICE=
ATT_OTA_SERVICE=
SOLICITACAO_BRINDE_SERVICE=
ALMOXARIFADO_TI=
ADMIN_SERVICE=http://host.docker.internal:3030
SYNAPSE_TI=
PE_CONFIRMADO_TESTE=
AMOSTRAS_TINTAS=
CHECKLIST_APP_SERVICE=
COLETORES_SERVICE=http://host.docker.internal:3131
CERTIFICADOS_DASS=http://host.docker.internal:3054

