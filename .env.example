# Copie este arquivo para .env e preencha as URLs dos serviços.
# cp .env.example .env

# Portas: interna do gateway e publicada pelo Docker Compose.
GATEWAY_PORT=2399
GATEWAY_HOST_PORT=2399

# Opções HTTP (os valores abaixo são os padrões).
CORS_ORIGINS=
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
PROXY_TIMEOUT_MS=0
STANDARD_PROXY_ERRORS_ENABLED=false

# Destinos obrigatórios. Em Docker, use DNS e porta interna do serviço.
# Exemplo: TELAS_SERVICE=http://telas-service:3000
MAIN_SERVICE=
TELAS_SERVICE=
SOBRACORTE_SERVICE=
UPLOAD_SERVICE=
DIESEL_SERVICE=
PORTA_EMERG_SERVICE=
PORTARIA_SERVICE=
INDEX_INFORMATIVO_SERVICE=
AUTOMATION_SERVICE=
DP_SERVICE=
QUIMICO_SERVICE=
PCP_SERVICE=
REFEITORIO_SERVICE=
LEAN_SERVICE=
ATT_OTA_SERVICE=
SOLICITACAO_BRINDE_SERVICE=
CHECKLIST_MAQUINA_SERVICE=
ALMOXARIFADO_TI=
DASS_USERS=
SYNAPSE_TI=
PE_CONFIRMADO_TESTE=
